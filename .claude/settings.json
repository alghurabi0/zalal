{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm guards *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm db:start)",
      "Bash(pnpm db:stop)",
      "Bash(pnpm db:reset)",
      "Bash(pnpm db:test)",
      "Bash(pnpm db:types)",
      "Bash(pnpm exec supabase migration new *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env*.local)",
      "Read(/supabase/.env)",
      "Edit(/design/**)",
      "Bash(*supabase link*)",
      "Bash(*supabase db push*)",
      "Bash(*supabase functions deploy*)",
      "Bash(*supabase secrets set*)",
      "Bash(*supabase *--linked*)",
      "Bash(*supabase *--project-ref*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.ts\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
