# Copy to .env.local (git-ignored). For local Supabase, take the values from
# `pnpm exec supabase status` (API_URL, PUBLISHABLE_KEY, SECRET_KEY), or run
# `node scripts/write-env-local.mjs`. Hosted dev and prod values live only in
# Vercel (docs/supabase-setup.md step 5, docs/deploy-setup.md).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# OTP delivery through OTPIQ (spec §9.1). Server only. Leave empty locally:
# without a key, login codes are printed in the `pnpm dev` terminal. On Vercel
# a key is required: an OTPIQ dev key (sk_dev_…) for Preview, which sends
# every code to the owner's phone, and a live key (sk_live_…) for Production.
OTPIQ_API_KEY=
# Optional: a registered SMS sender ID.
OTPIQ_SMS_SENDER_ID=
# Optional, all three or none: our own WhatsApp Business number and template.
OTPIQ_WHATSAPP_ACCOUNT_ID=
OTPIQ_WHATSAPP_PHONE_ID=
OTPIQ_WHATSAPP_TEMPLATE=

# Optional. Google Maps browser key (Maps JavaScript API + Places API (New)),
# restricted to the app's domains. Without it, Location shows a drawn map and
# places the pin only from "موقعي الحالي".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional. A Map ID from the same project, for the crew and home markers on
# Tracking and the admin live map. Without it they show the drawn map.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional. A Chromium for certificate PDFs off Vercel (spec §10.1). In cloud
# sessions /opt/pw-browsers/chromium; the e2e server gets Playwright's own.
# Without it, "تحميل الشهادة" fails locally; Vercel uses @sparticuz/chromium.
CERTIFICATE_CHROMIUM_PATH=

# Optional. Leave empty locally: Sentry and PostHog stay off without them.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
# Build only, for uploading source maps to Sentry (set in Vercel, not here).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
