# Copy to .env.local (git-ignored). For local Supabase, take the values from
# `pnpm exec supabase status` (API_URL, PUBLISHABLE_KEY, SECRET_KEY). Hosted dev
# and prod values live only in Vercel (docs/supabase-setup.md step 5).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
