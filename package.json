{
  "name": "zalal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build",
    "start": "next start",
    "lint": "eslint . && node scripts/guards.ts",
    "guards": "node scripts/guards.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start -x studio,imgproxy,logflare,vector,supavisor,edge-runtime,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts && prettier --write src/lib/database.types.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "11.9.0",
    "@serwist/next": "9.5.13",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@vis.gl/react-google-maps": "1.10.1",
    "browser-image-compression": "2.0.2",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "posthog-js": "1.438.20",
    "puppeteer-core": "25.11.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "serwist": "9.5.13",
    "tailwind-merge": "3.7.0",
    "tus-js-client": "4.3.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@serwist/cli": "9.5.13",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/google.maps": "3.66.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "web-push": "3.6.7"
  }
}
